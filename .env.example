# ─── MongoDB ───────────────────────────────────────────────────────────────
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=secret

# ─── LocalStack ────────────────────────────────────────────────────────────
LOCALSTACK_AUTH_TOKEN=

# ─── Auth Service ──────────────────────────────────────────────────────────
# Copy this block into auth-service/.env
AUTH_PORT=3001
AUTH_MONGO_URI=mongodb://root:secret@mongo:27017/auth_db?authSource=admin
JWT_SECRET=supersecretjwtkey_changeme_in_production
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# ─── Passport Service ──────────────────────────────────────────────────────
# Copy this block into passport-service/.env
PASSPORT_PORT=3002
PASSPORT_MONGO_URI=mongodb://root:secret@mongo:27017/passport_db?authSource=admin
AUTH_SERVICE_URL=http://auth-service:3001
KAFKA_BROKERS=kafka:29092
