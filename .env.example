# ─── MongoDB ───────────────────────────────────────────────────────────────
MONGO_ROOT_USER=your_mongo_username
MONGO_ROOT_PASS=your_strong_mongo_password

# ─── LocalStack ────────────────────────────────────────────────────────────
LOCALSTACK_AUTH_TOKEN=

# ─── Auth Service ──────────────────────────────────────────────────────────
# Copy relevant block into auth-service/.env
AUTH_PORT=3001
AUTH_MONGO_URI=mongodb://<MONGO_ROOT_USER>:<MONGO_ROOT_PASS>@mongo:27017/auth_db?authSource=admin
JWT_SECRET=your_strong_jwt_secret_here
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# ─── Passport Service ──────────────────────────────────────────────────────
# Copy relevant block into passport-service/.env
PASSPORT_PORT=3002
PASSPORT_MONGO_URI=mongodb://<MONGO_ROOT_USER>:<MONGO_ROOT_PASS>@mongo:27017/passport_db?authSource=admin
AUTH_SERVICE_URL=http://auth-service:3001
KAFKA_BROKERS=kafka:29092

# ─── Document Service ──────────────────────────────────────────────────────
DOCUMENT_PORT=3003
DOCUMENT_MONGO_URI=mongodb://<MONGO_ROOT_USER>:<MONGO_ROOT_PASS>@mongo:27017/document_db?authSource=admin
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localstack:4566
S3_BUCKET=meatec-documents

# ─── Notification Service ──────────────────────────────────────────────────
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-group
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
EMAIL_FROM=noreply@your-domain.com
NOTIFY_TO=admin@your-domain.com
